#!/usr/bin/env node

const fs = require("fs")
const path = require("path")

const source = fs.readFileSync(path.resolve(__dirname, "..", "Sensei.qml"), "utf8")
const barSource = fs.readFileSync(path.resolve(__dirname, "..", "BarWidget.qml"), "utf8")
const fastScrollSource = fs.readFileSync(
  path.resolve(__dirname, "..", "FastScrollHandler.qml"), "utf8")
const errors = []

function requirePattern(pattern, message) {
  if (!pattern.test(source)) errors.push(message)
}

function rejectPattern(pattern, message) {
  if (pattern.test(source)) errors.push(message)
}

const scrollBarStart = source.indexOf("ScrollBar.vertical: ScrollBar {")
const scrollBarEnd = source.indexOf("\n            Text {", scrollBarStart)
const scrollBarSource = scrollBarStart >= 0 && scrollBarEnd > scrollBarStart
  ? source.slice(scrollBarStart, scrollBarEnd)
  : ""

requirePattern(/^import QtQuick\.Controls$/m, "use Omarchy's native Qt Quick controls")
if (!/^import "Scroll\.js" as Scroll$/m.test(fastScrollSource))
  errors.push("use the tested fast-scroll policy")
requirePattern(/ScrollBar\.vertical:\s*ScrollBar\s*\{/, "attach an interactive native scrollbar to the lesson list")
if (!/interactive:\s*true/.test(scrollBarSource))
  errors.push("keep the native scrollbar draggable")
requirePattern(/flickableDirection:\s*Flickable\.VerticalFlick/, "limit the lesson list to vertical flicking")
requirePattern(/interactive:\s*contentHeight\s*>\s*height/, "disable list dragging when all lessons fit")
requirePattern(/reuseItems:\s*true/, "reuse lesson rows instead of rebuilding them during scrolling")
requirePattern(/height:\s*Math\.max\(0,[\s\S]*?parent\.height\s*-\s*dojoHeader\.height/, "keep the lesson list geometry valid while the panel is sizing")
requirePattern(/cacheBuffer:\s*Math\.max\(0,\s*height\s*\*\s*2\)/, "prepare nearby lesson rows without using a negative startup buffer")
requirePattern(/function openBrowser\(\)[\s\S]*?rebuildDisplay\(true\)/, "start each dojo visit at the top of the learning path")
requirePattern(/if\s*\(resetView\)\s*lessonList\.positionViewAtBeginning\(\)/, "reset the lesson offset after opening or changing filters")
rejectPattern(/flickDeceleration:/, "do not override the stock Omarchy flick behavior")
rejectPattern(/pixelAligned:\s*true/, "allow smooth subpixel movement while scrolling")
rejectPattern(/Component\.onCompleted:\s*lessonEnter\.restart\(\)/, "do not replay row-entry animation while scrolling")
rejectPattern(/id:\s*scrollTrack/, "do not replace the native scrollbar with a non-interactive track")
rejectPattern(/id:\s*lessonArea/, "do not place a MouseArea between scroll gestures and the lesson list")
requirePattern(/HoverHandler\s*\{[\s\S]*?if\s*\(hovered\s*&&\s*!fastScroll\.inputActive\s*&&\s*!lessonList\.moving\)/, "do not change the selected lesson during scroll input")
requirePattern(/TapHandler\s*\{[\s\S]*?root\.activateIndex\(model\.index\)/, "keep lesson rows clickable without consuming scroll gestures")
requirePattern(/FastScrollHandler\s*\{[\s\S]*?flickable:\s*lessonList/, "apply the tested fast-scroll handler to the lesson list")
requirePattern(/Behavior on color\s*\{\s*enabled:\s*!fastScroll\.inputActive/, "disable lesson-row color animation during scroll input")
if (!source.includes('text: "\\ue900"') || !/font\.family:\s*"omarchy"/.test(source))
  errors.push("show the square Omarchy logo in the dojo")
if (!/tooltipText:\s*"Omarchy Dojo · "\s*\+\s*root\.earnedXp\s*\+\s*" \/ "\s*\+\s*root\.courseXp\s*\+\s*" XP"/.test(barSource))
  errors.push("BarWidget.qml: keep the bar hover text to the dojo name and total XP")

if (errors.length) {
  errors.forEach(error => console.error(`Sensei.qml: ${error}`))
  process.exit(1)
}

console.log("Validated native lesson-list scrolling")
