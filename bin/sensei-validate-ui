#!/usr/bin/env node

const fs = require("fs")
const path = require("path")
const childProcess = require("child_process")
const vm = require("vm")

const controllerSource = fs.readFileSync(
  path.resolve(__dirname, "..", "Sensei.qml"), "utf8")
const source = fs.readFileSync(
  path.resolve(__dirname, "..", "DojoBrowser.qml"), "utf8")
const coachSource = fs.readFileSync(
  path.resolve(__dirname, "..", "LessonCoach.qml"), "utf8")
const barSource = fs.readFileSync(path.resolve(__dirname, "..", "BarWidget.qml"), "utf8")
const bindResolverSource = fs.readFileSync(
  path.resolve(__dirname, "..", "BindResolver.qml"), "utf8")
const fastScrollSource = fs.readFileSync(
  path.resolve(__dirname, "..", "FastScrollHandler.qml"), "utf8")
const beltBadgePath = path.resolve(__dirname, "..", "BeltBadge.qml")
const beltBadgeSource = fs.existsSync(beltBadgePath)
  ? fs.readFileSync(beltBadgePath, "utf8")
  : ""
const lessonsSource = fs.readFileSync(
  path.resolve(__dirname, "..", "lessons", "lessons.js"), "utf8")
const bindSelectionPath = path.resolve(__dirname, "..", "BindSelection.js")
const errors = []

function requirePattern(pattern, message) {
  if (!pattern.test(source)) errors.push(message)
}

function rejectPattern(pattern, message) {
  if (pattern.test(source)) errors.push(message)
}

const scrollBarStart = source.indexOf("ScrollBar.vertical: ScrollBar {")
const scrollBarEnd = source.indexOf("\n            Text {", scrollBarStart)
const scrollBarSource = scrollBarStart >= 0 && scrollBarEnd > scrollBarStart
  ? source.slice(scrollBarStart, scrollBarEnd)
  : ""

requirePattern(/^import QtQuick\.Controls$/m, "use Omarchy's native Qt Quick controls")
if (!/DojoBrowser\s*\{/.test(controllerSource)
    || !/LessonCoach\s*\{/.test(controllerSource))
  errors.push("Sensei.qml: keep the browser and coach behind separate module interfaces")
if (/PanelWindow\s*\{/.test(controllerSource))
  errors.push("Sensei.qml: keep window rendering out of the lesson controller")
if (!/PanelWindow\s*\{/.test(coachSource))
  errors.push("LessonCoach.qml: render the walkthrough through the coach module")
if (!fs.existsSync(beltBadgePath))
  errors.push("BeltBadge.qml: keep the belt summary behind one shared component")
if (!/^import qs\.Commons$/m.test(beltBadgeSource))
  errors.push("BeltBadge.qml: import Style from the shared Commons module")
if (/component BeltBadge\s*:/.test(source) || /component BeltBadge\s*:/.test(coachSource))
  errors.push("BeltBadge.qml: do not duplicate the shared badge inside either view")
if (!/BeltBadge\s*\{/.test(source) || !/BeltBadge\s*\{/.test(coachSource))
  errors.push("BeltBadge.qml: use the shared badge in the browser and coach")
if (/function (beltSummary|stepComplete|startLesson|openBrowser|dismiss)\s*\(/.test(coachSource))
  errors.push("LessonCoach.qml: emit view signals directly instead of forwarding them")
if (!/^import "Scroll\.js" as Scroll$/m.test(fastScrollSource))
  errors.push("use the tested fast-scroll policy")
if (!/^WheelHandler\s*\{/m.test(fastScrollSource))
  errors.push("FastScrollHandler.qml: receive wheel and touchpad input through a WheelHandler")
if (!/acceptedDevices:\s*PointerDevice\.Mouse\s*\|\s*PointerDevice\.TouchPad/.test(fastScrollSource))
  errors.push("FastScrollHandler.qml: accept both mouse-wheel and touchpad input")
if (!/blocking:\s*true/.test(fastScrollSource))
  errors.push("FastScrollHandler.qml: prevent handled input from scrolling twice")
if (!/if\s*\(useImmediateScroll\)[\s\S]*?flickable\.contentY\s*=\s*root\.scrollDestination/.test(fastScrollSource))
  errors.push("FastScrollHandler.qml: apply each pixel-scroll update to the lesson list")
requirePattern(/ScrollBar\.vertical:\s*ScrollBar\s*\{/, "attach an interactive native scrollbar to the lesson list")
if (!/interactive:\s*true/.test(scrollBarSource))
  errors.push("keep the native scrollbar draggable")
requirePattern(/flickableDirection:\s*Flickable\.VerticalFlick/, "limit the lesson list to vertical flicking")
requirePattern(/interactive:\s*contentHeight\s*>\s*height/, "disable list dragging when all lessons fit")
requirePattern(/reuseItems:\s*true/, "reuse lesson rows instead of rebuilding them during scrolling")
requirePattern(/height:\s*Math\.max\(0,[\s\S]*?parent\.height\s*-\s*dojoHeader\.height/, "keep the lesson list geometry valid while the panel is sizing")
requirePattern(/cacheBuffer:\s*Math\.max\(0,\s*height\s*\*\s*2\)/, "prepare nearby lesson rows without using a negative startup buffer")
requirePattern(/function open\(\)[\s\S]*?rebuildDisplay\(true\)/, "start each dojo visit at the top of the learning path")
requirePattern(/if\s*\(resetView\)\s*lessonList\.positionViewAtBeginning\(\)/, "reset the lesson offset after opening or changing filters")
rejectPattern(/flickDeceleration:/, "do not override the stock Omarchy flick behavior")
rejectPattern(/pixelAligned:\s*true/, "allow smooth subpixel movement while scrolling")
rejectPattern(/Component\.onCompleted:\s*lessonEnter\.restart\(\)/, "do not replay row-entry animation while scrolling")
rejectPattern(/id:\s*scrollTrack/, "do not replace the native scrollbar with a non-interactive track")
rejectPattern(/id:\s*lessonArea/, "do not place a MouseArea between scroll gestures and the lesson list")
requirePattern(/HoverHandler\s*\{[\s\S]*?if\s*\(hovered\s*&&\s*!fastScroll\.inputActive\s*&&\s*!lessonList\.moving\)/, "do not change the selected lesson during scroll input")
requirePattern(/TapHandler\s*\{[\s\S]*?root\.activateIndex\(model\.index\)/, "keep lesson rows clickable without consuming scroll gestures")
requirePattern(/FastScrollHandler\s*\{[\s\S]*?flickable:\s*lessonList/, "apply the tested fast-scroll handler to the lesson list")
requirePattern(/Behavior on color\s*\{\s*enabled:\s*!fastScroll\.inputActive/, "disable lesson-row color animation during scroll input")
if (!source.includes('text: "\\ue900"') || !/font\.family:\s*"omarchy"/.test(source))
  errors.push("show the square Omarchy logo in the dojo")
if (!/tooltipText:\s*"Omarchy Dojo · "\s*\+\s*root\.earnedXp\s*\+\s*" \/ "\s*\+\s*root\.courseXp\s*\+\s*" XP"/.test(barSource))
  errors.push("BarWidget.qml: keep the bar hover text to the dojo name and total XP")

if (!fs.existsSync(bindSelectionPath)) {
  errors.push("BindSelection.js: keep tutorial shortcuts readable when descriptions have aliases")
} else {
  const bindSelection = vm.createContext({})
  vm.runInContext(fs.readFileSync(bindSelectionPath, "utf8"), bindSelection, {
    filename: bindSelectionPath
  })
  vm.runInContext(lessonsSource, bindSelection, { filename: "lessons/lessons.js" })
  if (!bindSelection.shouldReplaceBinding("code:201", "SPACE"))
    errors.push("BindSelection.js: replace an unresolved keycode with a readable shortcut")
  if (bindSelection.shouldReplaceBinding("SPACE", "code:201"))
    errors.push("BindSelection.js: keep a readable shortcut instead of an unresolved alias")
  if (!bindSelection.shouldReplaceBinding("SPACE", "K"))
    errors.push("BindSelection.js: let a later readable user override win")

  const scan = childProcess.spawnSync(
    path.resolve(__dirname, "sensei-binds"), [], { encoding: "utf8" })
  if (scan.status === 0) {
    const activeBindings = {}
    String(scan.stdout || "").split("\n").forEach(line => {
      const parts = line.split("\t")
      if (parts.length < 3 || !parts[2]) return
      const description = parts[1].trim().toLowerCase()
      const current = activeBindings[description]
      if (!current || bindSelection.shouldReplaceBinding(current.key, parts[2]))
        activeBindings[description] = { modmask: Number(parts[0]) || 0, key: parts[2] }
    })
    const tutorialDescriptions = new Set(
      bindSelection.LESSONS.flatMap(lesson =>
        lesson.steps.map(step => step.bind).filter(Boolean)
      )
    )
    tutorialDescriptions.forEach(description => {
      const binding = activeBindings[description.toLowerCase()]
      if (binding && bindSelection.unresolvedKeycode(binding.key))
        errors.push(`BindResolver.qml: ${description} resolved to an unreadable keycode`)
    })
  }
}
if (!/^import "BindSelection\.js" as BindSelection$/m.test(bindResolverSource)
    || !/BindSelection\.shouldReplaceBinding\(/.test(bindResolverSource))
  errors.push("BindResolver.qml: use the tested shortcut-selection policy")

if (errors.length) {
  errors.forEach(error => console.error(`Sensei.qml: ${error}`))
  process.exit(1)
}

console.log("Validated modular Dojo UI, touchpad and mouse scrolling, and all active tutorial shortcuts")
