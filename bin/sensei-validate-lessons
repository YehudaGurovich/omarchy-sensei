#!/usr/bin/env node

const fs = require("fs")
const path = require("path")
const vm = require("vm")

const root = path.resolve(__dirname, "..")
const sourcePath = path.join(root, "lessons", "lessons.js")
const dojoPath = path.join(root, "Dojo.js")
const context = vm.createContext({})
const expectedLessonCount = 33
const expectedStepCount = 136
const expectedDifficultyGroups = {
  1: [
    "welcome-tour", "switch-workspaces", "move-window", "open-terminal",
    "float-window", "fullscreen", "omarchy-menu", "emojis", "clipboard"
  ],
  2: [
    "scratchpad", "menu-navigation", "keybinding-finder",
    "silent-window-move", "focus-and-swap", "resize-window",
    "workspace-layout", "theme-and-background", "stay-awake", "focus-modes",
    "quick-settings-panels", "set-reminder", "window-visual-toggles"
  ],
  3: [
    "make-screen-space", "lock-suspend-resume", "enable-microphone-plugin",
    "use-disable-microphone-plugin", "install-pacman-package",
    "create-web-app", "dictation", "screenshot-and-ocr",
    "screenrecord-and-share", "focus-sprint", "toolbelt-circuit"
  ]
}
const expectedDifficultyCounts = Object.fromEntries(
  Object.entries(expectedDifficultyGroups).map(([level, ids]) => [level, ids.length])
)
const expectedDifficultyById = Object.fromEntries(
  Object.entries(expectedDifficultyGroups).flatMap(([level, ids]) =>
    ids.map(id => [id, Number(level)])
  )
)

vm.runInContext(fs.readFileSync(sourcePath, "utf8"), context, {
  filename: sourcePath
})
vm.runInContext(fs.readFileSync(dojoPath, "utf8"), context, {
  filename: dojoPath
})

const lessons = context.LESSONS
const course = context.learningPath()
const errors = []
const ids = new Set()
const requiredLessonFields = [
  "id", "title", "keywords", "category", "duration", "difficulty",
  "intro", "outro", "steps"
]
const lessonStringFields = ["title", "category", "intro", "outro"]
const requiredStepFields = ["say", "bind", "await", "spotlight", "why"]
const spotlights = new Set([null, "bar", "menu", "emojis", "clipboard", "window"])

function fail(location, message) {
  errors.push(`${location}: ${message}`)
}

function validateAwait(value, location) {
  if (value === null) return
  const alternatives = Array.isArray(value) ? value : [value]
  if (alternatives.length === 0) fail(location, "await alternatives cannot be empty")
  alternatives.forEach((item, index) => {
    const itemLocation = `${location}${alternatives.length > 1 ? `[${index}]` : ""}`
    if (!item || typeof item !== "object" || Array.isArray(item)) {
      fail(itemLocation, "await must be null, an event object, or an event-object array")
      return
    }
    if (typeof item.event !== "string" || !item.event)
      fail(itemLocation, "event must be a non-empty string")
    if (typeof item.data !== "string" || !item.data)
      fail(itemLocation, "data must be a non-empty string")
    else {
      try { new RegExp(item.data) }
      catch (error) { fail(itemLocation, `data is not a valid regular expression: ${error.message}`) }
    }
  })
}

if (!Array.isArray(lessons)) {
  fail("LESSONS", "must be an array")
} else {
  lessons.forEach((lesson, lessonIndex) => {
    const lessonLocation = `lesson[${lessonIndex}]`
    requiredLessonFields.forEach(field => {
      if (!Object.prototype.hasOwnProperty.call(lesson, field))
        fail(lessonLocation, `missing ${field}`)
    })

    if (typeof lesson.id !== "string" || !lesson.id) fail(lessonLocation, "id must be a non-empty string")
    else if (ids.has(lesson.id)) fail(lessonLocation, `duplicate id ${lesson.id}`)
    else ids.add(lesson.id)
    if (!Array.isArray(lesson.keywords)) fail(lessonLocation, "keywords must be an array")
    else if (lesson.keywords.some(keyword => typeof keyword !== "string" || !keyword))
      fail(lessonLocation, "keywords must contain only non-empty strings")
    lessonStringFields.forEach(field => {
      if (typeof lesson[field] !== "string" || !lesson[field])
        fail(lessonLocation, `${field} must be a non-empty string`)
    })
    if (!Number.isInteger(lesson.duration) || lesson.duration < 1)
      fail(lessonLocation, "duration must be a positive integer")
    if (![1, 2, 3].includes(lesson.difficulty))
      fail(lessonLocation, "difficulty must be 1, 2, or 3")
    else if (expectedDifficultyById[lesson.id] !== lesson.difficulty)
      fail(lessonLocation, `expected difficulty ${expectedDifficultyById[lesson.id]} for ${lesson.id}`)
    if (!Array.isArray(lesson.steps) || lesson.steps.length === 0) {
      fail(lessonLocation, "steps must be a non-empty array")
      return
    }

    lesson.steps.forEach((step, stepIndex) => {
      const stepLocation = `${lesson.id || lessonLocation}.step[${stepIndex}]`
      requiredStepFields.forEach(field => {
        if (!Object.prototype.hasOwnProperty.call(step, field))
          fail(stepLocation, `missing ${field}`)
      })
      if (typeof step.say !== "string" || !step.say) fail(stepLocation, "say must be a non-empty string")
      if (step.bind !== null && (typeof step.bind !== "string" || !step.bind))
        fail(stepLocation, "bind must be null or a non-empty string")
      if (!spotlights.has(step.spotlight)) fail(stepLocation, `unknown spotlight ${step.spotlight}`)
      if (typeof step.why !== "string" || !step.why) fail(stepLocation, "why must be a non-empty string")
      if (step.hint !== undefined && (typeof step.hint !== "string" || !step.hint))
        fail(stepLocation, "hint must be a non-empty string")
      if (step.nextLabel !== undefined && (typeof step.nextLabel !== "string" || !step.nextLabel))
        fail(stepLocation, "nextLabel must be a non-empty string")
      if (step.nextLabel !== undefined && step.await !== null)
        fail(stepLocation, "nextLabel is only valid on a manual step")
      if (step.notOnWorkspace !== undefined && !Number.isInteger(step.notOnWorkspace))
        fail(stepLocation, "notOnWorkspace must be an integer")
      validateAwait(step.await, `${stepLocation}.await`)
    })
  })
}

const stepCount = Array.isArray(lessons)
  ? lessons.reduce((total, lesson) => total + (Array.isArray(lesson.steps) ? lesson.steps.length : 0), 0)
  : 0
if (Array.isArray(lessons) && lessons.length !== expectedLessonCount)
  fail("LESSONS", `expected ${expectedLessonCount} lessons, found ${lessons.length}`)
if (stepCount !== expectedStepCount)
  fail("LESSONS", `expected ${expectedStepCount} steps, found ${stepCount}`)

if (!Array.isArray(course) || course.length !== expectedLessonCount) {
  fail("COURSE", `expected ${expectedLessonCount} lessons in the learning path`)
} else {
  const courseIds = new Set(course.map(lesson => lesson.id))
  if (courseIds.size !== lessons.length || lessons.some(lesson => !courseIds.has(lesson.id)))
    fail("COURSE", "must contain every lesson exactly once")
  for (let index = 1; index < course.length; index++) {
    if (course[index].difficulty < course[index - 1].difficulty)
      fail("COURSE", `${course[index].id} is easier than the lesson before it`)
  }
}

const difficultyCounts = { 1: 0, 2: 0, 3: 0 }
if (Array.isArray(lessons)) lessons.forEach(lesson => difficultyCounts[lesson.difficulty]++)
Object.keys(expectedDifficultyCounts).forEach(level => {
  if (difficultyCounts[level] !== expectedDifficultyCounts[level])
    fail("LESSONS", `expected ${expectedDifficultyCounts[level]} difficulty-${level} lessons, found ${difficultyCounts[level]}`)
})

const expectedCourseXp = 680
const expectedBeltThresholds = [0, 10, 30, 60, 110, 190, 290, 440, 680]
const xpFunctions = [
  "xpForLesson", "totalXp", "xpForCompleted", "beltXpThreshold",
  "beltFor", "nextBeltFor", "xpUntilNextBelt", "beltProgress"
]
xpFunctions.forEach(name => {
  if (typeof context[name] !== "function") fail("BELTS", `missing XP function ${name}`)
})
if (!Array.isArray(context.BELTS) || context.BELTS.length !== 9) {
  fail("BELTS", "expected nine belt levels")
} else if (xpFunctions.every(name => typeof context[name] === "function")) {
  const courseXp = context.totalXp(course)
  if (courseXp !== expectedCourseXp)
    fail("BELTS", `expected ${expectedCourseXp} total course XP, found ${courseXp}`)
  expectedBeltThresholds.forEach((threshold, index) => {
    if (context.beltXpThreshold(index, courseXp) !== threshold)
      fail("BELTS", `expected ${context.BELTS[index].name} at ${threshold} XP`)
    if (typeof context.BELTS[index].title !== "string" || !context.BELTS[index].title)
      fail("BELTS", `belt ${index} needs an Omarchy title`)
  })
  const stageCosts = expectedBeltThresholds.slice(1).map((threshold, index) =>
    threshold - expectedBeltThresholds[index]
  )
  for (let index = 1; index < stageCosts.length; index++) {
    if (stageCosts[index] <= stageCosts[index - 1])
      fail("BELTS", "each belt must need more XP than the belt before it")
  }
  const lessonsPerStage = []
  let lessonIndex = 0
  let cumulativeXp = 0
  expectedBeltThresholds.slice(1).forEach(threshold => {
    const stageStart = lessonIndex
    while (lessonIndex < course.length && cumulativeXp < threshold) {
      cumulativeXp += context.xpForLesson(course[lessonIndex])
      lessonIndex++
    }
    if (cumulativeXp !== threshold)
      fail("BELTS", `${threshold} XP must end at a lesson boundary`)
    lessonsPerStage.push(lessonIndex - stageStart)
  })
  for (let index = 1; index < lessonsPerStage.length; index++) {
    if (lessonsPerStage[index] < lessonsPerStage[index - 1])
      fail("BELTS", "a later belt must not need fewer lessons")
  }
  const sampleXp = context.xpForCompleted(
    ["welcome-tour", "scratchpad", "focus-sprint"], course
  )
  if (sampleXp !== 60)
    fail("BELTS", `expected the lesson difficulty sample to earn 60 XP, found ${sampleXp}`)
  if (context.beltFor(80, courseXp).name !== "Green belt")
    fail("BELTS", "80 XP must award Green belt")
  if (Math.abs(context.beltProgress(80, courseXp) - 0.4) > 0.0001)
    fail("BELTS", "80 XP must fill two fifths of the Green-to-Blue XP bar")
  if (context.xpUntilNextBelt(80, courseXp) !== 30)
    fail("BELTS", "80 XP must leave 30 XP to Blue belt")
  if (context.beltFor(courseXp - 1, courseXp).name === "Black belt")
    fail("BELTS", "Black belt must require full course XP")
  if (context.beltFor(courseXp, courseXp).name !== "Black belt")
    fail("BELTS", "full course XP must award Black belt")
}

if (errors.length) {
  errors.forEach(error => console.error(error))
  process.exit(1)
}

console.log(`Validated ${lessons.length} lessons, ${stepCount} steps, and ${context.BELTS.length} belts`)
